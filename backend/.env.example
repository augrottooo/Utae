# Use only a project-owned database. Set UTAE_MIGRATE=true only after reviewing
# V1__identity_catalog.sql and confirming the selected schema is dedicated.
UTAE_DB_URL=jdbc:mysql://127.0.0.1:3306/utae_dev?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=UTC
UTAE_DB_USER=utae_app
UTAE_DB_PASSWORD=replace-with-local-secret
UTAE_MIGRATE=false

# Explicit dev-only maintainer bootstrap; password must be at least 16 characters.
# No default or fixed account is created when these are blank.
UTAE_BOOTSTRAP_USERNAME=
UTAE_BOOTSTRAP_PASSWORD=

UTAE_MINIO_ENDPOINT=http://127.0.0.1:9000
UTAE_MINIO_ACCESS_KEY=
UTAE_MINIO_SECRET_KEY=
UTAE_MINIO_BUCKET=utae

# Local filesystem mode is available only with the dev Spring profile.
UTAE_STORAGE_MODE=minio
UTAE_ASSET_ROOT=./var/assets
UTAE_API_PORT=8080
